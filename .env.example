# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is git-ignored. Never commit real credentials.

# ---- MySQL (the database is created automatically on first start if the user may create it)
DB_URL=jdbc:mysql://localhost:3306/hybrid_platform?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=
DB_PASSWORD=

# Docker Compose only: root password for the bundled MySQL container
MYSQL_ROOT_PASSWORD=

# ---- Application
APP_BASE_URL=http://localhost:8080
PORT=8080
# Storage for product images (public) and digital product files (private)
STORAGE_ROOT=./data/storage
MAX_UPLOAD_SIZE=512MB

# 32 random bytes, base64. Encrypts SMTP passwords, MFA secrets and license keys.
# PowerShell:  [Convert]::ToBase64String((1..32 | % { [byte](Get-Random -Max 256) }))
# Linux/macOS: openssl rand -base64 32
# Keep it safe: if it changes, saved SMTP passwords / MFA / license keys can no longer be decrypted.
APP_ENCRYPTION_KEY=
# Any long random string (used to hash IP addresses in affiliate click logs)
APP_HASH_SALT=

# ---- First admin of each storefront (created once on first start; must change password at first sign-in)
# There is no global admin: the shop admin cannot access the digital admin and vice versa.
BOOTSTRAP_SHOP_ADMIN_EMAIL=
BOOTSTRAP_SHOP_ADMIN_PASSWORD=
BOOTSTRAP_DIGITAL_ADMIN_EMAIL=
BOOTSTRAP_DIGITAL_ADMIN_PASSWORD=

# ---- Payments: "demo" simulates payments (refuses to run with the prod profile). Razorpay comes later.
PAYMENT_PROVIDER=demo

# ---- Security
# true = customers must verify their email before placing an order (requires SMTP configured in the admin panel)
REQUIRE_EMAIL_VERIFICATION=false
# true when served over HTTPS (production)
COOKIE_SECURE=false

# true = seed a few [Demo] products at startup. Default: true in dev, false with the prod profile.
# DEMO_CATALOG=true

# true (default) = affiliate-only storefronts: products redirect to partner stores. Customers can save deals in
# their cart, but checkout on this site is disabled.
# Set AFFILIATE_ONLY=false only if you also sell products yourself (take payment on this site).
# AFFILIATE_ONLY=true

# Partner prices older than this many days are hidden on the storefront until you re-confirm them in the admin.
# AFFILIATE_PRICE_MAX_AGE_DAYS=7

# Secret for the conversion postback URL your affiliate network calls:
#   https://your-domain/api/shop/affiliate/postback?token=<this>&txn=...&click_ref=...&sale=...&commission=...&status=...
# Leave empty to keep the postback endpoint disabled. Use a long random string.
# AFFILIATE_POSTBACK_TOKEN=

# SMTP is NOT configured here: each storefront sets its own mail server in its admin panel (Settings -> Email).
